    -->
  </section>

  <!-- AUTOMATION -->
  <section id="automation">
    <p class="label">What happens automatically</p>
    <div class="flow-list">

      <div class="flow-item">
        <div class="flow-dot"></div>
        <div>
          <p class="flow-trigger">Trigger · New client</p>
          <p class="flow-action">Welcome email sent → client added to dashboard → training plan assigned</p>
        </div>
      </div>

      <div class="flow-item">
        <div class="flow-dot"></div>
        <div>
          <p class="flow-trigger">Trigger · No activity for 3 days</p>
          <p class="flow-action">Re-engagement email sent to client → notification sent to PT</p>
        </div>
      </div>

      <div class="flow-item">
        <div class="flow-dot"></div>
        <div>
          <p class="flow-trigger">Trigger · Every Monday</p>
          <p class="flow-action">Weekly summary sent to PT — sessions completed, clients at risk</p>
        </div>
      </div>

    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing">
    <p class="label">Get started</p>
    <div class="pricing-card">
      <p class="price">997 kr / month</p>
      <p class="price-sub">Per PT · Unlimited clients · Cancel anytime</p>
      <ul class="feature-list">
        <li>PT dashboard + client portal</li>
        <li>Automatic onboarding flow</li>
        <li>Retention automations</li>
        <li>Weekly progress reports</li>
        <li>Stormie Performance support</li>
      </ul>
      <!-- Replace # with your Shopify product/checkout URL -->
      <a class="btn-cta" href="#" target="_blank">Start today</a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <a href="https://stormieperformance.com">← stormieperformance.com</a>
  </footer>

</body>
</html>
