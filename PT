      <div class="step">
        <span class="step-num">02</span>
        <div>
          <p class="step-title">You get notified instantly</p>
          <p class="step-desc">New client appears in your dashboard. Program is ready to send in one click.</p>
        </div>
        <span class="step-tag">Dashboard</span>
      </div>

      <div class="step">
        <span class="step-num">03</span>
        <div>
          <p class="step-title">Client trains — system tracks</p>
          <p class="step-desc">Client checks in after each session. You see their progress without asking.</p>
        </div>
        <span class="step-tag">App</span>
      </div>

      <div class="step">
        <span class="step-num">04</span>
        <div>
          <p class="step-title">System follows up automatically</p>
          <p class="step-desc">3 days no activity → client gets a nudge. You get a heads-up. No manual chasing.</p>
        </div>
        <span class="step-tag">Automation</span>
      </div>

    </div>
  </section>

  <!-- DEMO -->
  <section id="demo">
    <p class="label">Live demo</p>

    <div class="demo-grid">
      <div class="demo-card">
        <h3>PT Dashboard</h3>
        <p>Your clients, their status and progress — live.</p>
        <!-- Replace # with your Lovable PT dashboard URL -->
        <a href="#" target="_blank">Open dashboard →</a>
      </div>
      <div class="demo-card">
        <h3>Client portal</h3>
        <p>What your client sees — training plan, check-in, history.</p>
        <!-- Replace # with your Lovable client portal URL -->
        <a href="#" target="_blank">Open client view →</a>
      </div>
    </div>

    <!-- IFRAME PLACEHOLDER — replace with actual Lovable embed once ready -->
    <div class="iframe-placeholder">
      <span>PT Dashboard — coming soon</span>
      <small>iframe embed goes here</small>
    </div>

    <!--
    WHEN LOVABLE IS READY, REPLACE THE DIV ABOVE WITH:
    <iframe
      src="YOUR_LOVABLE_APP_URL"
